# 复制此文件为 .env 并按需修改（.env 不会提交到 git）
# 生成强随机密钥：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-random-64-character-hex-string

# 初始管理员密码（仅在第一次运行 flask init 生成管理员时使用）
ADMIN_PASSWORD=replace-with-a-strong-password

# 数据库连接（默认使用项目目录下的 data.sqlite）
# DATABASE_URL=sqlite:////absolute/path/to/data.sqlite

# ---- Web 人脸识别签到参数（详见 README「识别准确性设计」） ----
# 欧氏距离匹配阈值：真身良好光照通常 0.35~0.50；陌生人应 >0.55。
# 收紧可防误识（但过低会误拒，浏览器摄像头质量差会抬高真身距离）。
FACE_MATCH_TOLERANCE=0.55
# 落库前需连续命中的帧数（多帧确认，单帧误识概率 p -> p^N）
FACE_MATCH_VOTES=3
# 多帧确认窗口（秒），超时票数作废
FACE_MATCH_WINDOW=6.0

# 多人跨帧轨迹在漏检/离开后保留的秒数
FACE_TRACK_TTL=2.0

# auto：有 SFace 特征时使用 YuNet/SFace，否则无缝回退 dlib
# opencv：强制高速流水线；dlib：强制旧流水线（便于论文对照实验）
FACE_ENGINE=auto
SFACE_COSINE_THRESHOLD=0.40
# 第一候选与第二候选的最小余量，防止相似人脸临界误识
SFACE_MINIMUM_MARGIN=0.08
# 低于该质量分不提取身份特征，只跟踪并提示改善光照/姿态
FACE_MIN_QUALITY=0.38

# ---- 服务端活体检测（默认随机单动作，减少等待） ----
LIVENESS_REQUIRED=true
LIVENESS_POLICY=passive_adaptive
# 同一条人脸轨迹完成随机动作的时间窗口（秒）
LIVENESS_WINDOW=8.0
# 静默 MiniFASNet：累计两帧后，高置信真人无感通过，疑似攻击拒绝，
# 中间不确定区间只要求一个随机动作。阈值需用本机摄像头数据标定。
ANTI_SPOOF_ENABLED=true
LIVENESS_PASSIVE_MIN_FRAMES=2
LIVENESS_PASSIVE_ACCEPT=0.80
LIVENESS_PASSIVE_REJECT=0.15
LIVENESS_IDENTITY_STRONG=0.55
LIVENESS_QUALITY_STRONG=0.55
# EAR 小于闭眼阈值、随后重新高于睁眼阈值，记为一次眨眼
LIVENESS_EAR_CLOSED=0.20
LIVENESS_EAR_OPEN=0.24
# 归一化鼻尖水平位移的最小变化量；越大越难通过
LIVENESS_HEAD_DELTA=0.12
